{
  "name": "es_react",
  "version": "1.0.0",
  "scripts": {
    "build": "bun esbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "serve": "bunx --bun serve public",
    "wasm": "cd rust-interface && wasm-pack build --target web && cp pkg/rust_interface_bg.wasm ../public/rust_interface_bg.wasm",
    "wasm-trace": "wasm2wat public/rust_interface_bg.wasm -o public/rust_interface_bg.wat"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "esbuild-css-modules-plugin": "^3.1.0",
    "serve": "^14.2.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
